{
  "name": "awesome-wasm-tools-1000",
  "version": "0.1.0",
  "description": "Browser utility collection with generated inventory and explicit validation status",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run generate:sitemap && vite build",
    "preview": "vite preview",
    "generate:catalog": "node scripts/catalog.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/validate-dist.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run typecheck && npm run build && npm run check:dist"
  },
  "keywords": [
    "webassembly",
    "wasm",
    "tools",
    "image-processing",
    "offline",
    "pwa"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "parse5": "^7.3.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
